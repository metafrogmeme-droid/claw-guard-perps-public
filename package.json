{
  "name": "claw-guard-perps",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.32.1",
    "viem": "2.57.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "copy-lint": "node scripts/copy-lint.mjs",
    "gitleaks:selftest": "bash scripts/gitleaks-selftest.sh",
    "cli": "tsx src/cli/main.ts"
  },
  "bin": {
    "claw-guard": "src/cli/main.ts"
  }
}
