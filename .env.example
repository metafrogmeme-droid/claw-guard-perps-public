# Claw Guard Perps. Copy to a file OUTSIDE the repo (default ~/.config/claw-guard-perps/env, chmod 600).
# Testnet only: Somnia Tokyo testnet (Hideki), chain 50383.
NETWORK=hideki
# Bot key: places/cancels orders. Testnet throwaway only. Leave empty for read-only and sim runs.
PRIVATE_KEY=
# Receipt signer key for the gate. Optional: falls back to PRIVATE_KEY, then to an ephemeral key in sim.
GATE_SIGNER_PRIVATE_KEY=
# Linked-wallet mode: the dreamDEX account this bot key was linked to with "Link a Bot". Empty = trade the key's own account.
OWNER_ADDRESS=
# Optional: ClawGuardReceipts contract on Somnia testnet for on-chain receipt anchoring.
RECEIPTS_CONTRACT=
RPC_URL=https://api.hideki2.infra.testnet.somnia.network
WS_RPC_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
